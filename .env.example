NODE_ENV=development
PORT=3333

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=foodihub

# JWT
JWT_SECRET=dev_secret_key_please_change_in_production

# Redis
REDIS_URL=redis://redis:6379

# Encryption key for integration credentials (api_key/api_secret). Required in production.
# Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# Webhooks (optional)
# WEBHOOK_WORKER_INTERVAL_MS=30000   # 0 disables the worker
# WEBHOOK_RETENTION_DAYS=30
# WEBHOOK_FAILED_RETENTION_DAYS=90
# WEBHOOK_ALLOW_PRIVATE=true         # allow localhost/private webhook destinations (dev only)
