# Copy to deploy/.env.prod and fill in. NEVER commit .env.prod (it is in .gitignore).

# Address people will open. With a domain: app.mydomain.com.br (point an A record to the server IP).
# Without one: app.<IP with dots>.sslip.io, e.g. app.203.0.113.10.sslip.io (free, gets a real certificate).
SITE_ADDRESS=

# Database (the password: openssl rand -hex 24)
DB_USER=foodihub
DB_PASSWORD=
DB_NAME=foodihub

# Secrets (each one: openssl rand -hex 32). Losing the encryption key makes saved integration keys unreadable: back it up.
JWT_SECRET=
INTEGRATION_ENCRYPTION_KEY=

# Behind Caddy there is one proxy: lets the login rate limit see the real client address
TRUST_PROXY=1

# Store sign-up: leave true only while creating the first store, then set false and restart the backend
ALLOW_PUBLIC_REGISTRATION=true

PORT=3333
