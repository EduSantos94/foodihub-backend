{
  "name": "foodihub-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:seed": "tsx src/database/migrate.ts seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "typeorm": "^0.3.20",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.1.14",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^8.5.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^26.0.0",
    "@types/cors": "^2.8.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/jest": "^29.5.0",
    "typescript": "^7.0.0",
    "tsx": "^4.7.0",
    "vitest": "^2.0.0"
  }
}